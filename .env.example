# PostgreSQL connection string — server-side only.
# Supabase: Project Settings → Database → Connection string (use the pooled "Transaction" string on serverless hosts).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/gaos

# Supabase Auth. When these are missing, the app offers a dev sign-in (pick a seeded user) outside production.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Public URL of the app, used in e-mail confirmation links (e.g. https://growth.example.com)
NEXT_PUBLIC_SITE_URL=

# The e-mail that becomes Growth Architect (used by the seed and on first confirmed login).
ADMIN_EMAIL=

# OpenAI Growth Assistant — server-side only. The model is configurable on purpose; there is no default.
OPENAI_API_KEY=
OPENAI_MODEL=
